# ── Supabase project ─────────────────────────────────────────────
# Project URL and keys: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never expose in the browser,
# never prefix with NEXT_PUBLIC_. Used by API routes and scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign student session cookies (32+ random chars).
# Generate with:  openssl rand -hex 32
STUDENT_SESSION_SECRET=change-me

# Used only by scripts/create-super-admin.mjs (run locally, once)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
